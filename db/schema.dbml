Project tallyfin {
  Note: 'v0.1 D1 adapter contract; migrations are locally tested only. UTC epoch milliseconds and ISO project-local dates; no visitor, content or raw event table.'
}

Table funnel_runs {
  project_id text [not null]
  run_id text [not null, note: 'New UUIDv4 per task; shared browser/server linkage, never visitor identity or credential']
  schema_version integer [not null]
  funnel_id text [not null, note: 'Registered ordered funnel in this version']
  started_at bigint [not null, note: 'UTC milliseconds, immutable during the 72-hour active run']
  cohort_date text [not null, note: 'Project-local start date']
  dimension_key text [not null, note: 'Same required finite dimensions in all stages; typed JSON <=512 bytes']
  step_times_json text [not null, note: '2..10 nullable UTC millisecond milestones <=256 bytes; nondecreasing within 24 hours of start; first is start or null']
  expires_at bigint [not null, note: 'started_at + 72 hours; no extension on retry']
  indexes { (project_id, run_id) [pk]
    (project_id, expires_at) }
}
Ref: funnel_runs.(project_id, schema_version) > project_schemas.(project_id, version)

Table funnel_daily_counts {
  project_id text [not null]
  schema_version integer [not null]
  cohort_date text [not null, note: 'Project-local start date; retain today and preceding 89 days']
  funnel_id text [not null]
  dimension_key text [not null, note: 'Start-cohort finite classification <=512 bytes']
  step_index integer [not null, note: '0..9; consecutive reached counts are nonincreasing by index']
  reached_count bigint [not null, default: 0, note: 'Nonnegative safe integer; SQL trigger enforces neighbor invariant']
  updated_at bigint [not null]
  indexes { (project_id, schema_version, cohort_date, funnel_id, dimension_key, step_index) [pk]
    (project_id, cohort_date) }
}
Ref: funnel_daily_counts.(project_id, schema_version) > project_schemas.(project_id, version)

Table retention_cleanup_state {
  id integer [pk, not null, note: 'Singleton row, id = 1']
  last_project_id text [not null, default: '', note: 'Last attempted project, including failures; no FK so deleted projects do not reset the sweep']
  revision bigint [not null, default: 0, note: 'Compare-and-swap cursor guard; nonnegative safe integer']
}

Table projects {
  id text [pk, not null, note: 'Public routing ID, never a credential']
  name text [not null]
  status text [not null, note: 'active | paused']
  time_zone text [not null, note: 'Validated IANA zone, immutable after creation']
  allowed_origins_json text [not null, note: 'Exact scheme/host/port, no paths or wildcard; 0..16; empty disables browser collection']
  requests_per_minute integer [not null, note: '1..600; deployment admission control']
  new_receipts_per_utc_day integer [not null, note: '1..1000000; default 100000']
  latest_received_at bigint [note: 'Latest committed new receipt, not complete-delivery evidence']
  created_at bigint [not null]
  ingest_revision bigint [not null, default: 0, note: 'Adapter compare-and-swap guard; nonnegative safe integer, incremented by every ingest commit']
}

Table project_grants {
  project_id text [not null, ref: > projects.id]
  issuer text [not null, note: 'Trusted admin issuer, control plane only']
  subject text [not null, note: 'Opaque admin principal, no email or visitor identity']
  role text [not null, note: 'reader | owner']
  created_at bigint [not null]
  indexes {
    (project_id, issuer, subject) [pk]
    (issuer, subject, project_id)
  }
}

Table project_publishers {
  project_id text [not null, ref: > projects.id]
  issuer text [not null, note: 'Verified machine issuer; independent from administrator grants']
  subject text [not null, note: 'Opaque machine principal; never an event or visitor identifier']
  created_at bigint [not null, note: 'UTC epoch milliseconds; explicit provisioning only, no permission backfill']
  grant_id text [not null, unique, default: `lower(hex(randomblob(16)))`, note: 'Immutable lowercase 32-hex grant generation; regrant creates a new ID even within one millisecond. Concurrency metadata, never a credential.']
  indexes { (project_id, issuer, subject) [pk] }
}

Table project_creators {
  issuer text [not null, note: 'Trusted admin issuer; separate creation permission']
  subject text [not null, note: 'Verified administrator subject; never a visitor identity']
  max_projects integer [not null, note: '1..1000; projects created through the API by this principal']
  created_at bigint [not null]
  indexes { (issuer, subject) [pk] }
}

Table admin_changes {
  id text [pk, not null, note: 'Random UUID, used only as a history record and pagination tie-breaker']
  project_id text [not null, ref: > projects.id]
  occurred_at bigint [not null, note: 'UTC epoch milliseconds; retain 90 days; cleanup bounded per project']
  actor_kind text [not null, note: 'administrator | local_operator']
  actor_issuer text [note: 'Verified admin issuer, null for offline operator']
  actor_subject text [note: 'Verified admin subject, null for offline operator; never a visitor identity']
  action text [not null, note: 'project.created | project.settings_changed | schema.published | schema.status_changed | grant.created | grant.role_changed | grant.revoked | publisher.granted | publisher.revoked']
  fields_json text [not null, default: '[]', note: 'Changed setting keys only: name, status, allowedOrigins, requestsPerMinute, newReceiptsPerUtcDay; <=256 bytes; no values']
  schema_version integer [note: 'Present only for schema actions']
  target_issuer text [note: 'Grant or publisher target only; never credentials']
  target_subject text [note: 'Grant or publisher target only']
  before_role text [note: 'reader | owner | null; only grant actions']
  after_role text [note: 'reader | owner | null; only grant actions']
  indexes { (project_id, occurred_at, id) }
  Note: 'Append-only control plane history written atomically with API/CLI changes. No backfill, raw request/definition/setting values or capture of direct SQL writes. Owner-only pages exclude rows outside rolling 90 days even before physical cleanup.'
}

Table project_creations {
  project_id text [pk, not null, ref: > projects.id]
  issuer text [not null]
  subject text [not null]
  request_hash text [not null, note: 'Immutable canonical initial creation request SHA-256; persists after settings edits']
  created_at bigint [not null]
  indexes { (issuer, subject, project_id) }
  Note: 'Control plane only. Retained for the project lifetime; creation permission revocation does not reset quota history.'
}

Table project_schemas {
  project_id text [not null, ref: > projects.id]
  version integer [not null]
  status text [not null, note: 'active | retired; definitions immutable']
  definitions_json text [not null, note: 'Validated events/workflows and optional ordered funnels snapshot <=32 KiB; absent funnels stays absent for legacy hashes']
  published_at bigint [not null]
  retired_at bigint
  indexes {
    (project_id, version) [pk]
  }
}

Table event_receipts {
  project_id text [not null]
  source text [not null, note: 'browser | server; receipt identity is source-scoped']
  event_id text [not null, note: 'Random UUIDv4 per event, never a visitor ID']
  schema_version integer [not null]
  payload_hash text [not null, note: 'SHA-256 of canonical event/project/version/source; no raw payload']
  received_at bigint [not null]
  expires_at bigint [not null, note: 'received_at + 48h']
  indexes {
    (project_id, source, event_id) [pk]
    (project_id, expires_at)
  }
}
Ref: event_receipts.(project_id, schema_version) > project_schemas.(project_id, version)

Table workflow_attempts {
  project_id text [not null]
  source text [not null]
  attempt_id text [not null, note: 'Random per-operation UUIDv4; not reusable across versions/flows']
  schema_version integer [not null]
  workflow_id text [not null]
  started_at bigint [not null]
  cohort_date text [not null, note: 'Project-local date of started_at']
  dimension_key text [not null, note: 'Canonical typed JSON of workflow dimensions <=512 bytes']
  start_seen boolean [not null, default: false]
  terminal_kind text [note: 'success | failure | null, first committed terminal wins']
  terminal_at bigint
  expires_at bigint [not null, note: 'started_at + 72h']
  indexes {
    (project_id, source, attempt_id) [pk]
    (project_id, expires_at)
  }
}
Ref: workflow_attempts.(project_id, schema_version) > project_schemas.(project_id, version)

Table ingest_daily_usage {
  project_id text [not null, ref: > projects.id]
  utc_date text [not null, note: 'UTC receipt date, not event/cohort date']
  new_receipts integer [not null, default: 0, note: 'Includes new IDs for already-counted workflow phases']
  expires_at bigint [not null, note: 'UTC day end + 72h']
  indexes {
    (project_id, utc_date) [pk]
    (project_id, expires_at)
  }
}

Table ingest_minute_usage {
  project_id text [not null, ref: > projects.id]
  minute_start bigint [not null, note: 'UTC fixed-minute admission window; no IP or visitor key']
  request_count integer [not null, note: 'Saturates at global maximum + 1 (601), including denied/malformed requests; never decreases when project limits change']
  rejections_json text [not null, default: '{}', note: 'At most 2 KiB; fixed rejection reason -> {count,lastRejectedAt}. Minute quota recorded atomically with admission. Other reasons best effort for admitted requests only; no request content. Retain rejection minutes within seven UTC dates; empty minutes expire after two minutes.']
  indexes {
    (project_id, minute_start) [pk]
  }
}

Table event_daily_counts {
  project_id text [not null]
  schema_version integer [not null]
  source text [not null, note: 'browser | server; sources never merged']
  event_date text [not null, note: 'Project-local date of occurredAt']
  event_name text [not null]
  dimension_key text [not null, note: 'Canonical sorted typed properties; absence differs from false/0']
  count integer [not null, default: 0, note: 'Nonnegative safe integer']
  updated_at bigint [not null]
  indexes {
    (project_id, schema_version, source, event_date, event_name, dimension_key) [pk]
    (project_id, event_date)
  }
}
Ref: event_daily_counts.(project_id, schema_version) > project_schemas.(project_id, version)

Table workflow_daily_counts {
  project_id text [not null]
  schema_version integer [not null]
  source text [not null]
  cohort_date text [not null]
  workflow_id text [not null]
  dimension_key text [not null]
  started_count integer [not null, default: 0]
  succeeded_count integer [not null, default: 0]
  failed_count integer [not null, default: 0]
  updated_at bigint [not null]
  indexes {
    (project_id, schema_version, source, cohort_date, workflow_id, dimension_key) [pk]
    (project_id, cohort_date)
  }
}
Ref: workflow_daily_counts.(project_id, schema_version) > project_schemas.(project_id, version)
