{
  "project": { "id": "jobs", "name": "Job service", "status": "active", "timeZone": "UTC" },
  "schemaVersion": 1,
  "schemaStatus": "active",
  "allowedOrigins": ["https://jobs.example.invalid"],
  "limits": { "requestsPerMinute": 120, "newReceiptsPerUtcDay": 100000 },
  "events": [
    {
      "name": "job_requested",
      "label": "Job requested",
      "source": "browser",
      "properties": {}
    },
    {
      "name": "job_finished",
      "label": "Job finished",
      "source": "server",
      "properties": {
        "outcome": { "type": "enum", "values": ["success", "failure"], "required": true, "purpose": "Job result category" },
        "retried": { "type": "boolean", "required": false, "purpose": "Whether the job was retried" }
      }
    }
  ],
  "workflows": []
}
