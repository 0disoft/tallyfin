{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "tallyfin-auth",
  "main": "src/runtime.ts",
  "compatibility_date": "2026-10-24",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false,
  "triggers": { "crons": ["17 * * * *"] },
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "tallyfin-auth",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "AUTH_ORIGIN": "",
    "ADMIN_ORIGIN": "",
    "ADMIN_EMAIL": ""
  },
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": false
    }
  },
  "secrets": {
    "required": [
      "BETTER_AUTH_SECRET"
    ]
  }
}
