{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "tallyfin-auth",
  "main": "src/runtime.ts",
  "compatibility_date": "2026-10-24",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false,
  "durable_objects": { "bindings": [{ "name": "MAINTENANCE", "class_name": "MaintenanceClock" }] },
  "migrations": [{ "tag": "maintenance-v1", "new_sqlite_classes": ["MaintenanceClock"] }],
  "services": [{ "binding": "COLLECTOR_MAINTENANCE", "service": "tallyfin-collector", "entrypoint": "CollectorMaintenance" }],
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "tallyfin-auth",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "AUTH_ORIGIN": "",
    "ADMIN_ORIGIN": "",
    "ADMIN_EMAIL": "",
    "MAINTAIN_COLLECTOR": "false"
  },
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": false
    }
  },
  "secrets": {
    "required": [
      "BETTER_AUTH_SECRET"
    ]
  }
}
