{
  "name": "tallyfin",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node tools/runtime/stack.ts",
    "dev:admin": "npm run dev --workspace @tallyfin/admin --",
    "admin:config": "node tools/runtime/prepare-admin.ts",
    "install:prepare": "node tools/runtime/prepare-installation.ts",
    "install:setup": "node tools/runtime/setup-installation.ts",
    "install:check": "node tools/runtime/install-check.ts",
    "install:access-check": "node tools/runtime/install-access-check.ts",
    "monitor:access": "node tools/runtime/monitor-access.ts",
    "install:database-check": "node tools/runtime/install-database-check.ts",
    "admin:build-configured": "node apps/admin/scripts/build-configured.mjs",
    "admin:types": "node -e \"require('node:fs').mkdirSync('.tmp', { recursive: true })\" && wrangler types .tmp/admin-worker-types.d.ts --config apps/admin/wrangler.jsonc --env-interface AdminEnv && tsc -p apps/admin/tsconfig.worker.json",
    "admin:dry-run": "node tools/runtime/dry-run-admin.ts",
    "build:admin": "npm run build --workspace @tallyfin/admin",
    "typecheck:admin": "npm run typecheck --workspace @tallyfin/admin",
    "test:admin": "npm test --workspace @tallyfin/admin",
    "check:admin": "npm run typecheck:admin && npm run test:admin && npm run build:admin && npm run test:bundle --workspace @tallyfin/admin && npm run test:sites --workspace @tallyfin/admin",
    "typecheck": "npm run collector:types && tsc --noEmit && tsc -p apps/collector/tsconfig.runtime.json && npm run typecheck:admin && npm run admin:types",
    "test": "node --test --test-timeout=30000 packages/*/test/*.test.ts apps/*/test/*.test.ts tools/provision/test/*.test.ts tools/runtime/test/*.test.ts",
    "provision": "node tools/provision/cli.ts",
    "provision:remote-creators": "node tools/provision/remote-cli.ts",
    "verify:restore": "node tools/runtime/restore-drill.ts",
    "verify:sdk-packages": "node tools/sdk/verify-packages.mjs",
    "logs:summary": "node tools/runtime/summarize-observations.ts",
    "collector:dev": "node tools/runtime/dev.ts",
    "collector:config": "node tools/runtime/prepare.ts",
    "collector:types": "node -e \"require('node:fs').mkdirSync('.tmp', { recursive: true })\" && wrangler types .tmp/collector-types.d.ts --env-interface CollectorEnv --strict-vars=false",
    "collector:dry-run": "wrangler deploy --dry-run --outdir .tmp/collector-bundle",
    "test:core": "node --test packages/core/test/*.test.ts",
    "test:browser": "node --test packages/browser/test/*.test.ts",
    "test:server": "node --test packages/server/test/*.test.ts",
    "build:browser": "npm run build --workspace @tallyfin/browser",
    "build:server": "npm run build --workspace @tallyfin/server",
    "check:browser-size": "node tools/browser/check.mjs",
    "bench:browser": "node tools/browser-bench/run.mjs",
    "verify:admin-login": "node tools/browser-bench/admin-login.mjs",
    "verify:admin-onboarding": "node tools/browser-bench/admin-onboarding.mjs",
    "verify:admin-access": "node tools/browser-bench/admin-access.mjs",
    "verify:admin-settings-recovery": "node tools/browser-bench/admin-settings-recovery.mjs",
    "verify:admin-settings-navigation": "node tools/browser-bench/admin-settings-navigation.mjs",
    "verify:admin-schema-comparison": "node tools/browser-bench/admin-schema-comparison.mjs",
    "verify:admin-server-draft": "node tools/browser-bench/admin-server-draft.mjs",
    "verify:admin-mode-exit": "node tools/browser-bench/admin-mode-exit.mjs",
    "verify:admin-analysis-access": "node tools/browser-bench/admin-analysis-access.mjs",
    "verify:admin-goal-access": "node tools/browser-bench/admin-goal-access.mjs",
    "verify:admin-project-search": "node tools/browser-bench/admin-project-search.mjs",
    "bench:collector": "node tools/runtime/collector-bench.ts",
    "bench:retained": "node tools/runtime/retained-bench.ts",
    "bench:cluster": "node tools/runtime/cluster-bench.ts",
    "verify:server-recovery": "node tools/runtime/server-recovery.ts",
    "check": "npm run typecheck && npm test && npm run check:browser-size"
  },
  "devDependencies": {
    "@types/node": "^24",
    "esbuild": "^0",
    "miniflare": "^4",
    "typescript": "^7",
    "wrangler": "^4"
  },
  "overrides": {
    "undici": "^7.29.1",
    "sharp": "^0.35.5"
  }
}
