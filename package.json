{
  "name": "tallyfin",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "engines": { "node": ">=24" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-timeout=30000 packages/*/test/*.test.ts apps/*/test/*.test.ts",
    "test:core": "node --test packages/core/test/*.test.ts",
    "test:browser": "node --test packages/browser/test/*.test.ts",
    "build:browser": "npm run build --workspace @tallyfin/browser",
    "check:browser-size": "node tools/browser/check.mjs",
    "check": "npm run typecheck && npm test && npm run check:browser-size"
  },
  "devDependencies": { "typescript": "^7", "miniflare": "^4", "esbuild": "^0" },
  "overrides": { "undici": "^7.29.1", "sharp": "^0.35.5" }
}
