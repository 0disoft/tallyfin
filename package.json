{
  "name": "tallyfin",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "engines": { "node": ">=24" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test packages/*/test/*.test.ts",
    "test:core": "node --test packages/core/test/*.test.ts",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": { "typescript": "^7", "miniflare": "^4", "esbuild": "^0" },
  "overrides": { "undici": "^7.29.1", "sharp": "^0.35.5" }
}
